# LLM: any OpenAI-compatible API (cloud, Ollama, llama.cpp server)
# Ollama on the host machine: http://localhost:11434/v1
# From inside docker compose:  http://host.docker.internal:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
# Used only by docker compose for the api container (cloud API: put the same URL as above)
LLM_BASE_URL_DOCKER=http://host.docker.internal:11434/v1
LLM_MODEL=yandex/YandexGPT-5-Lite-8B-instruct-GGUF
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=120

# Embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Vector store: qdrant | faiss
VECTOR_STORE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=tk_rf
FAISS_DIR=data/index/faiss

# Ingest
RAW_TEXT_PATH=data/raw/tk_rf.txt
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Retrieval
TOP_K=5
MIN_SCORE=0.0
