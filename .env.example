# LLM: any OpenAI-compatible API (cloud, Ollama, llama.cpp server)
# Ollama on the host machine: http://localhost:11434/v1
# From inside docker compose:  http://host.docker.internal:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
# Used only by docker compose for the api container (cloud API: put the same URL as above)
LLM_BASE_URL_DOCKER=http://host.docker.internal:11434/v1
LLM_MODEL=yandex/YandexGPT-5-Lite-8B-instruct-GGUF
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=120
# YandexGPT's chat template in Ollama has no system role (system prompt is silently dropped),
# so instructions are merged into the user message. For OpenAI-like cloud APIs set true.
LLM_SYSTEM_ROLE=false

# Embeddings: base model (default) or the model fine-tuned on Russian law (ru-law-retrieval):
#   EMBEDDING_MODEL=alekseevpavel04/multilingual-e5-small-ru-law
# Each model has its own index: after switching run POST /ingest (or scripts/ingest.py).
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Vector store: qdrant | faiss
VECTOR_STORE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=tk_rf
FAISS_DIR=data/index/faiss

# Ingest
RAW_TEXT_PATH=data/raw/tk_rf.txt
CHUNK_SIZE=500
CHUNK_OVERLAP=75

# Retrieval
TOP_K=5
# cosine threshold; tune per embedding model (their score scales differ)
MIN_SCORE=0.0
